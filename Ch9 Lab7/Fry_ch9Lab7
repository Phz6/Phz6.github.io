void showMenu()
    {
      cout << "Select one of the following options:" << endl;
      cout << "1: To print the entire teams data" << endl;
      cout << "2: To print a player's data" << endl;
      cout << "3: To update a player's touch downs" << endl;
      cout << "4: To update a player's number of catches" << endl;
      cout << "5: To update a player's passing yards" << endl;
      cout << "6: To update a player's receiving yards" << endl;
      cout << "7: To update a player's rushing yards" << endl;
      cout << "99: To quit the program" << endl;
    }
void updateTouchDowns(int amount, int& touchDowns)
    {
      cout << "Enter the amount of touch downs to add: ";
      cin >> amount;
      touchDowns += amount;
    }

void updateCatches(int amount, int& numberOfCatches)
    {
      numberOfCatches += numberOfCatches;
    }
void updatePassingYards(int amount, int& passingYards)
    {
      cout << "Enter the amount of passing yards to add: ";
      cin >> amount;
      passingYards += amount;
    }
void updateReceivingYards(int amount, int& receivingYards)
    {
      cout << "Enter the amount of receiving yards to add: ";
      cin >> amount;
      receivingYards += amount;
    }
void updateRushingYards(int amount, int& rushingYards)
    {
      cout << "Enter the amount of rushing yards to add: ";
      cin >> amount;
      rushingYards += amount;
    }
void printPlayerData(string playerName, string playerPosition, int touchDowns, int numberOfCatches, int passingYards, int receivingYards, int rushingYards)
    {
      cout << "Player Name: " << playerName << endl;
      cout << "Player Position: " << playerPosition << endl;
      cout << "Touch Downs: " << touchDowns << endl;
      cout << "Number of Catches: " << numberOfCatches << endl;
      cout << "Passing Yards: " << passingYards << endl;
      cout << "Receiving Yards: " << receivingYards << endl;
      cout << "Rushing Yards: " << rushingYards << endl;
    }
